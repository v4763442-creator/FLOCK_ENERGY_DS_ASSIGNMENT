# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/

# Virtual environment
venv/
.venv/
env/

# OS files
.DS_Store
Thumbs.db

# Data files, archives and parquet caches (NEVER commit raw or processed REFIT data or archives)
data/
*.parquet
*.7z
*.zip
*.tar.gz

# Ignore all CSVs except those in results/
*.csv
!results/*.csv

# Allow JSON files in results/
!results/*.json

# Local interview notes and scratch checkpoints (local only)
INTERVIEW_NOTES.md
results/checkpoint_*.md
